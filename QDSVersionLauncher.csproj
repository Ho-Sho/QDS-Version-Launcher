<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>QDS Version Launcher</AssemblyTitle>
    <Product>QDS Version Launcher</Product>
    <RootNamespace>QDSVersionLauncher</RootNamespace>
    <AssemblyName>QDSVersionLauncher</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.1</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishDir>$(OutputPath)</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- app.ico is embedded into the EXE via ApplicationIcon above, and also
         copied next to the EXE so MainForm/ManagePathsForm can load it
         directly at runtime (see TryLoadIcon). -->
    <None Include="app.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- qsys.ico is the separate icon used for the .qsys file association
         (see FileAssociation.Register). Must be copied to the output/publish
         folder, otherwise File.Exists() there always fails and the file-type
         icon silently falls back to the EXE's own icon. -->
    <None Include="qsys.ico" CopyToOutputDirectory="PreserveNewest" Condition="Exists('qsys.ico')" />
  </ItemGroup>

</Project>